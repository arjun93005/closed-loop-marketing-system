# Loop — example environment file
#
# Copy this to `.env` in the same directory and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. This example file IS
# committed on purpose: it documents every knob the app has, so a new machine
# (or a future you) can see what needs setting without reading the source.
#
# Values already present in the real environment win over this file. On a host
# like Railway or Render you set these in the platform's secrets panel instead,
# and ship no .env at all.


# --- NODE_ENV ---------------------------------------------------------------
# development | production | test
# Anything else aborts boot — a typo like "prodution" silently falling back to
# development rules is how servers end up unprotected.
# In production, LOOP_PASSWORD becomes mandatory (see below).
NODE_ENV=development


# --- PORT -------------------------------------------------------------------
# TCP port to listen on. Most hosts inject this automatically; leave it unset
# locally to use the default 4070.
# PORT=4070


# --- LOOP_DB ----------------------------------------------------------------
# Path to the SQLite database file. Defaults to server/loop.db.
#
# IMPORTANT for deployment: many container platforms wipe the filesystem on every
# redeploy. Point this at a mounted persistent volume or you WILL lose all your
# events and bets on the next deploy.
#     LOOP_DB=/data/loop.db
#
# The parent directory must already exist — the server refuses to start otherwise,
# which is how you find out the volume was never mounted BEFORE losing data.
# LOOP_DB=./loop.db


# --- LOOP_PASSWORD ----------------------------------------------------------
# Shared password protecting the dashboard and every /api/* route.
# `/collect` and `/loop.js` always stay public — visitors' browsers hit those and
# have no way to hold a password.
#
# Optional in development (the server warns loudly and runs unprotected).
# REQUIRED in production, minimum 16 characters, or the server refuses to boot.
#
# Generate a strong one:
#     openssl rand -base64 24
# LOOP_PASSWORD=


# --- ANTHROPIC_API_KEY ------------------------------------------------------
# Enables AI script generation at GET /api/generate-scripts.
# Entirely optional: without it that endpoint returns a clear 503 and the
# template-based /api/script keeps working.
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
